{
  "name": "elceo-land",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:ui-foundation": "node scripts/check-ui-foundation.mjs",
    "sync:backend-handoff": "node scripts/sync-backend-handoff.mjs",
    "verify:backend-handoff": "node scripts/verify-backend-handoff.mjs",
    "check:reference": "node scripts/check-reference-image.mjs",
    "test:foundation": "node --test scripts/foundation-integrity.test.mjs",
    "dev:vite": "vite",
    "build:vite": "tsc -b && vite build",
    "dev:next": "npm run dev --workspace=@elceo/frontend-candidate --",
    "build:next": "npm run build --workspace=@elceo/frontend-candidate",
    "start:next": "npm run start --workspace=@elceo/frontend-candidate --",
    "typecheck:next": "npm run typecheck --workspace=@elceo/frontend-candidate",
    "test:m1": "node --test scripts/m1-foundation.test.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.0.0",
    "gsap": "^3.15.0",
    "clsx": "^2.1.1",
    "three": "^0.170.0",
    "@react-three/fiber": "9.7.0",
    "@react-three/drei": "^10.0.0",
    "framer-motion": "^11.11.0",
    "lightweight-charts": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0",
    "typescript": "^6.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "workspaces": [
    "apps/frontend"
  ],
  "engines": {
    "node": ">=22 <23"
  }
}
